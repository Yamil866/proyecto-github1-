<!DOCTYPE html>
 <html>
 <head> <head/>
     <title>Mi página con Pac-Man</title>
     <style>
         body {
             background-color: #111;
             font-family: Arial, sans-serif;
             text-align: center;
             padding-top: 80px;
             color: white;
             overflow: hidden;
         }
         h1 {
             color: #ffeb3b;
             font-size: 32px;
         }
         .pacman {
             position: absolute;
             top: 50px;
             left: 0;
             font-size: 60px;
             animation: recorrer 12s linear infinite;
             z-index: 10;
         }
         @keyframes recorrer {
             0% { top: 50px; left: 0px; }
             25% { top: 50px; left: calc(100% - 80px); transform: scaleX(1); }
             25.1% { top: 50px; left: calc(100% - 80px); transform: scaleX(-1); }
             50% { top: calc(100% - 80px); left: 0px; transform: scaleX(-1); }
             50.1% { top: calc(100% - 80px); left: 0px; transform: scaleX(1); }
             75% { top: calc(100% - 80px); left: calc(100% - 80px); transform: scaleX(1); }
             75.1% { top: calc(100% - 80px); left: calc(100% - 80px); transform: scaleX(-1); }
             100% { top: 50px; left: 0px; transform: scaleX(-1); }
         }
         .punto {
             position: absolute;
             width: 14px;
             height: 14px;
             background-color: #fff;
             border-radius: 50%;
         }
     </style>
 </head>
 <body>
